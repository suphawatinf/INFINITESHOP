#!/data/data/com.termux/files/usr/bin/bash

# ==========================================
# 0. ระบบตั้งค่าและตรวจสอบรหัสผ่าน
# ==========================================
VALID_PASSWORDS=("1234" "5678" "prem99" "infinite2026")
MAX_ATTEMPTS=3

check_password() {
    clear
    echo "=========================================="
    echo "        INFINITE SHOP - VERIFICATION      "
    echo "=========================================="
    
    local ATTEMPTS=0
    while [ $ATTEMPTS -lt $MAX_ATTEMPTS ]; do
        read -s -p "กรุณาใส่รหัสผ่านเพื่อใช้งาน: " USER_PASS
        echo ""
        
        local IS_CORRECT=0
        for PASS in "${VALID_PASSWORDS[@]}"; do
            if [ "$USER_PASS" == "$PASS" ]; then
                IS_CORRECT=1
                break
            fi
        done
        
        if [ $IS_CORRECT -eq 1 ]; then
            echo -e "[✓] เข้าสู่ระบบสำเร็จ!\n"
            sleep 1
            return 0
        else
            ATTEMPTS=$((ATTEMPTS + 1))
            REMAINING=$((MAX_ATTEMPTS - ATTEMPTS))
            if [ $REMAINING -gt 0 ]; then
                echo -e "[✗] รหัสผ่านไม่ถูกต้อง! (เหลืออีก $REMAINING ครั้ง)\n"
            fi
        fi
    done

    echo "[!] คุณใส่รหัสผ่านผิดเกินกำหนด ปิดการทำงานระบบ"
    exit 1
}

# ==========================================
# 1. ฟังก์ชันดาวน์โหลดและติดตั้ง
# ==========================================
install_apk() {
    local NAME=$1
    local URL=$2
    local TEMP_FILE="/sdcard/Download/temp_app.apk"

    echo ""
    echo "[+] Downloading: $NAME..."
    curl -sL "$URL" -o "$TEMP_FILE"

    if [ -f "$TEMP_FILE" ]; then
        echo "[+] Installing: $NAME..."
        
        # ติดตั้งผ่าน Root และเคลียร์ Cursor ตัวหนังสือเบี้ยว
        su -c "pm install -r -g '$TEMP_FILE'" > /dev/null 2>&1
        local STATUS=$?
        printf "\r"

        if [ $STATUS -eq 0 ]; then
            echo "[✓] $NAME Installed Successfully!"
        else
            echo "[✗] Failed to install $NAME"
        fi
        rm -f "$TEMP_FILE"
    else
        echo "[✗] Download failed for $NAME"
    fi
}

# ==========================================
# 2. ฟังก์ชันแสดงรายการและรับค่าตัวเลือก
# ==========================================
process_selection() {
    local CATEGORY_NAME=$1
    shift
    local APPS=("$@")
    local TOTAL=${#APPS[@]}

    clear
    echo "=========================================="
    echo "          $CATEGORY_NAME          "
    echo "=========================================="
    for i in "${!APPS[@]}"; do
        echo "  [$((i+1))] $CATEGORY_NAME Clone #$((i+1))"
    done
    echo "=========================================="
    echo " ตัวอย่างการพิมพ์: 1-5 | 1 3 5 |"
    echo "------------------------------------------"

    read -p "เลือกตัวโคลนที่ต้องการติดตั้ง: " INPUT_CHOICE

    local SELECTED_INDICES=()

    if [[ "$INPUT_CHOICE" == "all" || "$INPUT_CHOICE" == "ALL" ]]; then
        for i in "${!APPS[@]}"; do
            SELECTED_INDICES+=($i)
        done
    else
        for ITEM in $INPUT_CHOICE; do
            if [[ "$ITEM" =~ ^([0-9]+)-([0-9]+)$ ]]; then
                START=${BASH_REMATCH[1]}
                END=${BASH_REMATCH[2]}
                for ((i=START; i<=END; i++)); do
                    SELECTED_INDICES+=($((i-1)))
                done
            elif [[ "$ITEM" =~ ^[0-9]+$ ]]; then
                SELECTED_INDICES+=($((ITEM-1)))
            fi
        done
    fi

    for INDEX in "${SELECTED_INDICES[@]}"; do
        if [ $INDEX -ge 0 ] && [ $INDEX -lt $TOTAL ]; then
            install_apk "$CATEGORY_NAME Clone #$((INDEX+1))" "${APPS[$INDEX]}"
        else
            echo ""
            echo "[!] หมายเลข $((INDEX+1)) ไม่มีในรายการ"
        fi
    done
}

