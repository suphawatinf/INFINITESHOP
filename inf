# ==========================================

# 1. ตรวจสอบรหัสผ่านก่อนเป็นอันดับแรก
check_password

# 2. เมื่อผ่านรหัสแล้ว แสดงเมนูหลัก
clear
printf "\r\033[K==========================================\n"
printf "\r\033[K          INFINITE SHOP INSTALLER         \n"
printf "\r\033[K==========================================\n"
printf "\r\033[K  [1] Delta Clones (%d Apps)\n" "${#DELTA_APPS[@]}"
