#!/data/data/com.termux/files/usr/bin/bash

CHANGE_ID="f77d5bd408f375b3"

change_identity() {
    su -c "settings put secure android_id $CHANGE_ID" > /dev/null 2>&1
    su -c "cmd connectivity airplane-mode enable" > /dev/null 2>&1
    sleep 2
    su -c "cmd connectivity airplane-mode disable" > /dev/null 2>&1
    sleep 3
}

VALID_PASSWORDS=("1234" "5678" "prem99" "infinite2026")
MAX_ATTEMPTS=3

check_password() {
    clear
    echo -e "\033[1;36m╔════════════════════════════════════════╗\033[0m"
    echo -e "\033[1;36m║       INFINITE SHOP - VERIFICATION     ║\033[0m"
    echo -e "\033[1;36m╚════════════════════════════════════════╝\033[0m"
    
    local ATTEMPTS=0
    while [ $ATTEMPTS -lt $MAX_ATTEMPTS ]; do
        echo -ne "\r\033[1;33m🔑 รหัสผ่าน: \033[0m"
        read -s USER_PASS
        echo ""
        
        local IS_CORRECT=0
        for PASS in "${VALID_PASSWORDS[@]}"; do
            if [ "$USER_PASS" == "$PASS" ]; then
                IS_CORRECT=1
                break
            fi
        done
        
        if [ $IS_CORRECT -eq 1 ]; then
            echo -e "\r\033[1;32m🚀 สำเร็จ!\033[0m\n"
            sleep 1
            return 0
        else
            ATTEMPTS=$((ATTEMPTS + 1))
            REMAINING=$((MAX_ATTEMPTS - ATTEMPTS))
            if [ $REMAINING -gt 0 ]; then
                echo -e "\r\033[1;31m❌ ผิด! (เหลือ $REMAINING ครั้ง)\033[0m\n"
            fi
        fi
    done

    echo -e "\r\033[1;31m🚫 ล็อกระบบชั่วคราว\033[0m"
    exit 1
}

install_apk() {
    local NAME=$1
    local URL=$2
    local TEMP_FILE="/sdcard/Download/temp_app.apk"

    change_identity

    # บังคับเคอร์เซอร์กลับซ้ายสุดด้วย \r ก่อนพิมพ์ข้อความเสมอ
    echo -e "\r\n\033[1;34m[↓] กำลังดาวน์โหลด: $NAME\033[0m"
    curl -sL "$URL" -o "$TEMP_FILE"

    if [ -f "$TEMP_FILE" ]; then
        echo -e "\r\033[1;33m[⚡] กำลังติดตั้งลงเครื่อง...\033[0m"
        su -c "pm install -r -g '$TEMP_FILE' > /dev/null 2>&1"
        local STATUS=$?

        if [ $STATUS -eq 0 ]; then
            echo -e "\r\033[1;32m[✓] ติดตั้ง $NAME สำเร็จเรียบร้อย\033[0m"
        else
            echo -e "\r\033[1;31m[✗] ติดตั้ง $NAME ไม่สำเร็จ\033[0m"
        fi
        rm -f "$TEMP_FILE"
    else
        echo -e "\r\033[1;31m[✗] ดาวน์โหลดไฟล์ไม่สำเร็จ\033[0m"
    fi
    echo ""
}

process_selection() {
    local CATEGORY_NAME=$1
    shift
    local APPS=("$@")
    local TOTAL=${#APPS[@]}

    clear
    echo -e "\033[1;36m╔════════════════════════════════════════╗\033[0m"
    echo -e "\033[1;36m║         📂 หมวดหมู่: $CATEGORY_NAME          ║\033[0m"
    echo -e "\033[1;36m╚════════════════════════════════════════╝\033[0m"
    
    for i in "${!APPS[@]}"; do
        echo -e "\r\033[1;32m[$((i+1))]\033[0m \033[1;1m$CATEGORY_NAME $((i+1))\033[0m"
    done
    
    echo -e "\033[1;36m──────────────────────────────────────────\033[0m"
    echo -e "\033[1;33m💡 พิมพ์: 1-5 | 1 3 5 | all\033[0m"
    echo -e "\033[1;36m──────────────────────────────────────────\033[0m"

    echo -ne "\r\033[1;36m🎯 เลือก: \033[0m"
    read INPUT_CHOICE
    echo ""

    local SELECTED_INDICES=()

    if [[ "$INPUT_CHOICE" == "all" || "$INPUT_CHOICE" == "ALL" ]]; then
        for i in "${!APPS[@]}"; do
            SELECTED_INDICES+=($i)
        done
    else
        for ITEM in $INPUT_CHOICE; do
            if [[ "$ITEM" =~ ^([0-9]+)-([0-9]+)$ ]]; then
                START=${BASH_REMATCH[1]}
                END=${BASH_REMATCH[2]}
                for ((i=START; i<=END; i++)); do
                    SELECTED_INDICES+=($((i-1)))
                done
            elif [[ "$ITEM" =~ ^[0-9]+$ ]]; then
                SELECTED_INDICES+=($((ITEM-1)))
            fi
        done
    fi

    for INDEX in "${SELECTED_INDICES[@]}"; do
        if [ $INDEX -ge 0 ] && [ $INDEX -lt $TOTAL ]; then
            install_apk "$CATEGORY_NAME $((INDEX+1))" "${APPS[$INDEX]}"
        else
            echo -e "\r\033[1;31m[!] ไม่มีหมายเลข $((INDEX+1))\033[0m"
        fi
    done
}

DELTA_APPS=(
  "https://github.com/boom2556255734-crypto/INFINITESHOP/releases/download/V1.0/delta1.apk"
  "https://github.com/boom2556255734-crypto/INFINITESHOP/releases/download/V1.0/delta2.apk"
)

ARCEUS_APPS=(
  "https://github.com/boom2556255734-crypto/INFINITESHOP/releases/download/V1.0/ArceusX.lite.by.Suphawat.1_2.737.1584.apk"
  "https://github.com/boom2556255734-crypto/INFINITESHOP/releases/download/V1.0/ArceusX.lite.by.Suphawat.2_2.737.1584.apk"
  "https://github.com/boom2556255734-crypto/INFINITESHOP/releases/download/V1.0/ArceusX.lite.by.Suphawat.3_2.737.1584.apk"
  "https://github.com/boom2556255734-crypto/INFINITESHOP/releases/download/V1.0/ArceusX.lite.by.Suphawat.4_2.737.1584.apk"
  "https://github.com/boom2556255734-crypto/INFINITESHOP/releases/download/V1.0/ArceusX.lite.by.Suphawat.5_2.737.1584.apk"
)

check_password

clear
echo -e "\033[1;32m╔════════════════════════════════════════╗\033[0m"
echo -e "\033[1;32m║         INFINITE SHOP INSTALLER        ║\033[0m"
echo -e "\033[1;32m╚════════════════════════════════════════╝\033[0m"
echo -e "\r\033[1;36m[1]\033[0m Delta Clones (\033[1;33m${#DELTA_APPS[@]}\033[0m Apps)"
echo -e "\r\033[1;36m[2]\033[0m ArceusX lite (\033[1;33m${#ARCEUS_APPS[@]}\033[0m Apps)"
echo -e "\033[1;32m──────────────────────────────────────────\033[0m"
echo -ne "\r\033[1;33m🎯 เลือก (1-2): \033[0m"
read MAIN_CHOICE
echo ""

case $MAIN_CHOICE in
    1)
        process_selection "Delta" "${DELTA_APPS[@]}"
        ;;
    2)
        process_selection "ArceusX lite" "${ARCEUS_APPS[@]}"
        ;;
    *)
        echo -e "\r\033[1;31m[!] ผิดพลาด\033[0m"
        ;;
esac

echo -e "\033[1;32m──────────────────────────────────────────\033[0m"
echo -e "\r\033[1;32m          ✨ ทำงานเสร็จสิ้น โชคดีครับ! ✨       \033[0m"
echo -e "\033[1;32m──────────────────────────────────────────\033[0m"
