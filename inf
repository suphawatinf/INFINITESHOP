#!/data/data/com.termux/files/usr/bin/bash

# ==========================================
# ค่า Android ID ที่ต้องการกำหนด
# ==========================================
CHANGE_ID="f77d5bd408f375b3"

# ==========================================
# ฟังก์ชันเปลี่ยน IP และเซ็ต Android ID แบบเงียบสนิท
# ==========================================
change_identity() {
    su -c "settings put secure android_id $CHANGE_ID" > /dev/null 2>&1
    su -c "cmd connectivity airplane-mode enable" > /dev/null 2>&1
    sleep 2
    su -c "cmd connectivity airplane-mode disable" > /dev/null 2>&1
    sleep 3
}

# ==========================================
# 0. ระบบตั้งค่าและตรวจสอบรหัสผ่าน
# ==========================================
VALID_PASSWORDS=("1234" "5678" "prem99" "infinite2026")
MAX_ATTEMPTS=3

check_password() {
    clear
    echo -e "\033[1;36m╔════════════════════════════════════════╗\033[0m"
    echo -e "\033[1;36m║       INFINITE SHOP - VERIFICATION     ║\033[0m"
    echo -e "\033[1;36m╚════════════════════════════════════════╝\033[0m"
    
    local ATTEMPTS=0
    while [ $ATTEMPTS -lt $MAX_ATTEMPTS ]; do
        echo -ne "\033[1;33m 🔑 กรุณาใส่รหัสผ่านเพื่อเข้าใช้งาน: \033[0m"
        read -s USER_PASS
        echo ""
        
        local IS_CORRECT=0
        for PASS in "${VALID_PASSWORDS[@]}"; do
            if [ "$USER_PASS" == "$PASS" ]; then
                IS_CORRECT=1
                break
            fi
        done
        
        if [ $IS_CORRECT -eq 1 ]; then
            echo -e "\033[1;32m 🚀 เข้าสู่ระบบสำเร็จ! กำลังพาเข้าสู่ระบบ...\033[0m\n"
            sleep 1.5
            return 0
        else
            ATTEMPTS=$((ATTEMPTS + 1))
            REMAINING=$((MAX_ATTEMPTS - ATTEMPTS))
            if [ $REMAINING -gt 0 ]; then
                echo -e "\033[1;31m ❌ รหัสผ่านไม่ถูกต้อง! (เหลือโอกาสอีก $REMAINING ครั้ง)\033[0m\n"
            fi
        fi
    done

    echo -e "\033[1;31m 🚫 คุณใส่รหัสผ่านผิดเกินกำหนด ล็อกระบบชั่วคราว\033[0m"
    exit 1
}

# ==========================================
# 1. ฟังก์ชันดาวน์โหลดและติดตั้ง
# ==========================================
install_apk() {
    local NAME=$1
    local URL=$2
    local TEMP_FILE="/sdcard/Download/temp_app.apk"

    # เปลี่ยน IP และ ID แบบเงียบๆ
    change_identity

    echo -e "\033[1;34m[↓] กำลังดาวน์โหลด: $NAME...\033[0m"
    curl -sL "$URL" -o "$TEMP_FILE"

    if [ -f "$TEMP_FILE" ]; then
        echo -e "\033[1;33m[⚡] กำลังติดตั้ง: $NAME...\033[0m"
        
        su -c "pm install -r -g '$TEMP_FILE' > /dev/null 2>&1"
        local STATUS=$?

        if [ $STATUS -eq 0 ]; then
            echo -e "\033[1;32m[✓] ติดตั้ง $NAME สำเร็จ!\033[0m"
        else
            echo -e "\033[1;31m[✗] ติดตั้ง $NAME ไม่สำเร็จ\033[0m"
        fi
        rm -f "$TEMP_FILE"
    else
        echo -e "\033[1;31m[✗] ดาวน์โหลดล้มเหลวสำหรับ $NAME\033[0m"
    fi
    echo ""
}

# ==========================================
# 2. ฟังก์ชันแสดงรายการและรับค่าตัวเลือก
# ==========================================
process_selection() {
    local CATEGORY_NAME=$1
    shift
    local APPS=("$@")
    local TOTAL=${#APPS[@]}

    clear
    # เปลี่ยนกรอบและเส้นเป็นสีฟ้าคราม (Cyan)
    echo -e "\033[1;36m╔════════════════════════════════════════╗\033[0m"
    echo -e "\033[1;36m║         📂 หมวดหมู่: $CATEGORY_NAME          ║\033[0m"
    echo -e "\033[1;36m╚════════════════════════════════════════╝\033[0m"
    
    for i in "${!APPS[@]}"; do
        echo -e "  \033[1;32m[$((i+1))]\033[0m \033[1;1m$CATEGORY_NAME $((i+1))\033[0m"
    done
    
    echo -e "\033[1;36m──────────────────────────────────────────\033[0m"
    echo -e "\033[1;33m 💡 รูปแบบการพิมพ์: 1-5 | 1 3 5 | all\033[0m"
    echo -e "\033[1;36m──────────────────────────────────────────\033[0m"

    echo -ne "\033[1;36m 🎯 เลือกรายการที่ต้องการติดตั้ง: \033[0m"
    read INPUT_CHOICE
    echo ""

    local SELECTED_INDICES=()

    if [[ "$INPUT_CHOICE" == "all" || "$INPUT_CHOICE" == "ALL" ]]; then
        for i in "${!APPS[@]}"; do
            SELECTED_INDICES+=($i)
        done
    else
        for ITEM in $INPUT_CHOICE; do
            if [[ "$ITEM" =~ ^([0-9]+)-([0-9]+)$ ]]; then
                START=${BASH_REMATCH[1]}
                END=${BASH_REMATCH[2]}
                for ((i=START; i<=END; i++)); do
                    SELECTED_INDICES+=($((i-1)))
                done
            elif [[ "$ITEM" =~ ^[0-9]+$ ]]; then
                SELECTED_INDICES+=($((ITEM-1)))
            fi
        done
    fi

    for INDEX in "${SELECTED_INDICES[@]}"; do
        if [ $INDEX -ge 0 ] && [ $INDEX -lt $TOTAL ]; then
            install_apk "$CATEGORY_NAME $((INDEX+1))" "${APPS[$INDEX]}"
        else
            echo -e "\033[1;31m[!] หมายเลข $((INDEX+1)) ไม่มีในรายการ\033[0m"
        fi
    done
}

# ==========================================
# รายชื่อลิงก์ Direct Link
