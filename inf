#!/data/data/com.termux/files/usr/bin/bash

# ==========================================
# ค่า Android ID ที่ต้องการกำหนด
# ==========================================
CHANGE_ID="f77d5bd408f375b3"

# ==========================================
# ฟังก์ชันเปลี่ยน IP และเซ็ต Android ID แบบเงียบๆ
# ==========================================
change_identity() {
    su -c "settings put secure android_id $CHANGE_ID" > /dev/null 2>&1
    su -c "cmd connectivity airplane-mode enable" > /dev/null 2>&1
    sleep 2
    su -c "cmd connectivity airplane-mode disable" > /dev/null 2>&1
    sleep 3
}

# ==========================================
# 0. ระบบตั้งค่าและตรวจสอบรหัสผ่าน
# ==========================================
VALID_PASSWORDS=("1234" "5678" "prem99" "infinite2026")
MAX_ATTEMPTS=3

check_password() {
    clear
    printf "\r\033[K==========================================\n"
    printf "\r\033[K        INFINITE SHOP - VERIFICATION      \n"
    printf "\r\033[K==========================================\n"
    
    local ATTEMPTS=0
    while [ $ATTEMPTS -lt $MAX_ATTEMPTS ]; do
        read -s -p "กรุณาใส่รหัสผ่านเพื่อใช้งาน: " USER_PASS
        printf "\n"
        
        local IS_CORRECT=0
        for PASS in "${VALID_PASSWORDS[@]}"; do
            if [ "$USER_PASS" == "$PASS" ]; then
                IS_CORRECT=1
                break
            fi
        done
        
        if [ $IS_CORRECT -eq 1 ]; then
            printf "\r\033[K[✓] เข้าสู่ระบบสำเร็จ!\n\n"
            sleep 1
            return 0
        else
            ATTEMPTS=$((ATTEMPTS + 1))
            REMAINING=$((MAX_ATTEMPTS - ATTEMPTS))
            if [ $REMAINING -gt 0 ]; then
                printf "\r\033[K[✗] รหัสผ่านไม่ถูกต้อง! (เหลืออีก %d ครั้ง)\n\n" "$REMAINING"
            fi
        fi
    done

    printf "\r\033[K[!] คุณใส่รหัสผ่านผิดเกินกำหนด ปิดการทำงานระบบ\n"
    exit 1
}

# ==========================================
# 1. ฟังก์ชันดาวน์โหลดและติดตั้ง
# ==========================================
install_apk() {
    local NAME=$1
    local URL=$2
    local TEMP_FILE="/sdcard/Download/temp_app.apk"

    # ทำการเปลี่ยน Android ID และ IP แบบเงียบๆ ก่อนดาวน์โหลด
    change_identity

    printf "\r\033[K[+] Downloading: %s...\n" "$NAME"
    curl -sL "$URL" -o "$TEMP_FILE"

    if [ -f "$TEMP_FILE" ]; then
        printf "\r\033[K[+] Installing: %s...\n" "$NAME"
        
        # ติดตั้งด้วย Root
        su -c "pm install -r -g '$TEMP_FILE' > /dev/null 2>&1"
        local STATUS=$?

        # รีเซ็ตเคอร์เซอร์กลับขอบซ้ายสุด
        printf "\r\033[K"

        if [ $STATUS -eq 0 ]; then
            printf "\r\033[K[✓] %s Installed Successfully!\n" "$NAME"
        else
            printf "\r\033[K[✗] Failed to install %s\n" "$NAME"
        fi
        rm -f "$TEMP_FILE"
    else
        printf "\r\033[K[✗] Download failed for %s\n" "$NAME"
    fi
}

# ==========================================
# 2. ฟังก์ชันแสดงรายการและรับค่าตัวเลือก
# ==========================================
process_selection() {
    local CATEGORY_NAME=$1
    shift
    local APPS=("$@")
    local TOTAL=${#APPS[@]}

    clear
    printf "\r\033[K==========================================\n"
    printf "\r\033[K          %s          \n" "$CATEGORY_NAME"
    printf "\r\033[K==========================================\n"
    for i in "${!APPS[@]}"; do
        printf "\r\033[K  [%d] %s Clone #%d\n" "$((i+1))" "$CATEGORY_NAME" "$((i+1))"
    done
    printf "\r\033[K==========================================\n"
    printf "\r\033[K ตัวอย่างการพิมพ์: 1-5 | 1 3 5 | all\n"
    printf "\r\033[K------------------------------------------\n"

    read -p "เลือกตัวโคลนที่ต้องการติดตั้ง: " INPUT_CHOICE
    printf "\r\033[K"

    local SELECTED_INDICES=()

    if [[ "$INPUT_CHOICE" == "all" || "$INPUT_CHOICE" == "ALL" ]]; then
        for i in "${!APPS[@]}"; do
            SELECTED_INDICES+=($i)
        done
    else
        for ITEM in $INPUT_CHOICE; do
            if [[ "$ITEM" =~ ^([0-9]+)-([0-9]+)$ ]]; then
                START=${BASH_REMATCH[1]}
                END=${BASH_REMATCH[2]}
                for ((i=START; i<=END; i++)); do
                    SELECTED_INDICES+=($((i-1)))
                done
            elif [[ "$ITEM" =~ ^[0-9]+$ ]]; then
                SELECTED_INDICES+=($((ITEM-1)))
            fi
        done
    fi

    for INDEX in "${SELECTED_INDICES[@]}"; do
        if [ $INDEX -ge 0 ] && [ $INDEX -lt $TOTAL ]; then
            install_apk "$CATEGORY_NAME Clone #$((INDEX+1))" "${APPS[$INDEX]}"
        else
            printf "\r\033[K[!] หมายเลข %d ไม่มีในรายการ\n" "$((INDEX+1))"
        fi
    done
}

