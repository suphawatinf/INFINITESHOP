#!/data/data/com.termux/files/usr/bin/bash

CHANGE_ID="f77d5bd408f375b3"

change_identity() {
    su -c "settings put secure android_id $CHANGE_ID" > /dev/null 2>&1
    su -c "cmd connectivity airplane-mode enable" > /dev/null 2>&1
    sleep 2
    su -c "cmd connectivity airplane-mode disable" > /dev/null 2>&1
    sleep 3
}

VALID_PASSWORDS=("1234" "5678" "prem99" "infinite2026")
MAX_ATTEMPTS=3

check_password() {
    clear
    echo "╔════════════════════════════════════════╗"
    echo "║       INFINITE SHOP - VERIFICATION     ║"
    echo "╚════════════════════════════════════════╝"
    
    local ATTEMPTS=0
    while [ $ATTEMPTS -lt $MAX_ATTEMPTS ]; do
        echo -n "🔑 รหัสผ่าน: "
        read -s USER_PASS
        echo ""
        
        local IS_CORRECT=0
        for PASS in "${VALID_PASSWORDS[@]}"; do
            if [ "$USER_PASS" == "$PASS" ]; then
                IS_CORRECT=1
                break
            fi
        done
        
        if [ $IS_CORRECT -eq 1 ]; then
            echo "🚀 สำเร็จ!"
            sleep 1
            return 0
        else
            ATTEMPTS=$((ATTEMPTS + 1))
            REMAINING=$((MAX_ATTEMPTS - ATTEMPTS))
            if [ $REMAINING -gt 0 ]; then
                echo "❌ รหัสผ่านไม่ถูกต้อง (เหลือ $REMAINING ครั้ง)"
                echo ""
            fi
        fi
    done

    echo "🚫 ล็อกระบบชั่วคราว"
    exit 1
}

install_apk() {
    local NAME=$1
    local URL=$2
    local TEMP_FILE="/sdcard/Download/temp_app.apk"

    change_identity

    echo "------------------------------------------"
    echo "📥 กำลังดาวน์โหลด: $NAME"
    
    curl -sL "$URL" -o "$TEMP_FILE" > /dev/null 2>&1

    if [ -f "$TEMP_FILE" ]; then
        echo "⚡ กำลังติดตั้ง: $NAME ..."
        
        su -c "pm install -r -g '$TEMP_FILE'" > /dev/null 2>&1
        local STATUS=$?

        if [ $STATUS -eq 0 ]; then
            echo "✅ ติดตั้ง $NAME สำเร็จ!"
        else
            echo "❌ ติดตั้ง $NAME ไม่สำเร็จ"
        fi
        rm -f "$TEMP_FILE" > /dev/null 2>&1
    else
        echo "❌ ดาวน์โหลดไฟล์ไม่สำเร็จ (ลิงก์อาจมีปัญหา)"
    fi
}

process_selection() {
    local CATEGORY_NAME=$1
    shift
    local APPS=("$@")
    local TOTAL=${#APPS[@]}

    clear
    echo "╔════════════════════════════════════════╗"
    echo "║         📂 หมวดหมู่: $CATEGORY_NAME          ║"
    echo "╚════════════════════════════════════════╝"
    
    for i in "${!APPS[@]}"; do
        echo "[$((i+1))] $CATEGORY_NAME $((i+1))"
    done
    
    echo "------------------------------------------"
    echo "💡 รูปแบบการพิมพ์: 1-5 หรือ 1 3 5 หรือ all"
    echo "------------------------------------------"

    echo -n "🎯 ระบุหมายเลขที่ต้องการเลือก: "
    read INPUT_CHOICE
    echo ""

    local SELECTED_INDICES=()

    if [[ "$INPUT_CHOICE" == "all" || "$INPUT_CHOICE" == "ALL" ]]; then
        for i in "${!APPS[@]}"; do
            SELECTED_INDICES+=($i)
        done
    else
        for ITEM in $INPUT_CHOICE; do
            if [[ "$ITEM" =~ ^([0-9]+)-([0-9]+)$ ]]; then
                START=${BASH_REMATCH[1]}
                END=${BASH_REMATCH[2]}
                for ((i=START; i<=END; i++)); do
                    SELECTED_INDICES+=($((i-1)))
                done
            elif [[ "$ITEM" =~ ^[0-9]+$ ]]; then
                SELECTED_INDICES+=($((ITEM-1)))
            fi
        done
    fi

    clear
    echo "╔════════════════════════════════════════╗"
    echo "║         🚀 กำลังดำเนินการติดตั้ง          ║"
    echo "╚════════════════════════════════════════╝"

    for INDEX in "${SELECTED_INDICES[@]}"; do
        if [ $INDEX -ge 0 ] && [ $INDEX -lt $TOTAL ]; then
            install_apk "$CATEGORY_NAME $((INDEX+1))" "${APPS[$INDEX]}"
        else
            echo "[!] ไม่มีหมายเลข $((INDEX+1)) ในระบบ"
        fi
    done
}

