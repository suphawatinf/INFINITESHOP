#!/data/data/com.termux/files/usr/bin/bash

CHANGE_ID="f77d5bd408f375b3"

change_identity() {
    su -c "settings put secure android_id $CHANGE_ID" > /dev/null 2>&1
    su -c "cmd connectivity airplane-mode enable" > /dev/null 2>&1
    sleep 2
    su -c "cmd connectivity airplane-mode disable" > /dev/null 2>&1
    sleep 3
}

VALID_PASSWORDS=("1234" "5678" "prem99" "infinite2026")
MAX_ATTEMPTS=3

check_password() {
    clear
    echo "╔════════════════════════════════════════╗"
    echo "║       INFINITE SHOP - VERIFICATION     ║"
    echo "╚════════════════════════════════════════╝"
    
    local ATTEMPTS=0
    while [ $ATTEMPTS -lt $MAX_ATTEMPTS ]; do
        printf "🔑 รหัสผ่าน: "
        read -s USER_PASS
        echo ""
        
        local IS_CORRECT=0
        for PASS in "${VALID_PASSWORDS[@]}"; do
            if [ "$USER_PASS" == "$PASS" ]; then
                IS_CORRECT=1
                break
            fi
        done
        
        if [ $IS_CORRECT -eq 1 ]; then
            echo "🚀 สำเร็จ!"
            sleep 1
            return 0
        else
            echo "❌ รหัสผ่านไม่ถูกต้อง"
            ATTEMPTS=$((ATTEMPTS + 1))
        fi
    done
    echo "🚫 ล็อกระบบชั่วคราว"
    exit 1
}

install_apk() {
    local NAME=$1
    local URL=$2
    local TEMP_FILE="/sdcard/Download/temp_app.apk"

    change_identity

    printf "\n------------------------------------------\n"
    printf "📥 กำลังดาวน์โหลด: %s\n" "$NAME"
    
    # ลบไฟล์เก่าก่อนโหลด
    rm -f "$TEMP_FILE"
    
    # ดาวน์โหลดพร้อมแสดงสถานะและรองรับ Redirect ของ GitHub
    curl -# -L "$URL" -o "$TEMP_FILE"

    # ตรวจสอบว่ามีไฟล์จริง และขนาดไฟล์ต้องมากกว่า 1MB (ป้องกันโหลดไฟล์ HTML ผิดพลาด)
    if [ -f "$TEMP_FILE" ]; then
        local FILE_SIZE=$(du -k "$TEMP_FILE" | cut -f1)
        if [ "$FILE_SIZE" -gt 1024 ]; then
            printf "⚡ กำลังติดตั้ง: %s ...\n" "$NAME"
            su -c "pm install -r -g '$TEMP_FILE'" > /dev/null 2>&1
            local STATUS=$?

            if [ $STATUS -eq 0 ]; then
                printf "✅ ติดตั้งสำเร็จ: %s\n" "$NAME"
            else
                printf "❌ ติดตั้งไม่สำเร็จ (ติดปัญหาแพ็กเกจระบบ)\n"
            fi
        else
            printf "❌ ดาวน์โหลดล้มเหลว: ไฟล์เสียหายหรือลิงก์ไม่ถูกต้อง\n"
        fi
        rm -f "$TEMP_FILE"
    else
        printf "❌ ไม่พบไฟล์ที่ดาวน์โหลด\n"
    fi
    printf "------------------------------------------\n"
}

process_selection() {
    local CATEGORY_NAME=$1
    shift
    local APPS=("$@")
    local TOTAL=${#APPS[@]}

    clear
    echo "╔════════════════════════════════════════╗"
    echo "║         📂 หมวดหมู่: $CATEGORY_NAME          ║"
    echo "╚════════════════════════════════════════╝"
    
    for i in "${!APPS[@]}"; do
        echo "[$((i+1))] $CATEGORY_NAME $((i+1))"
    done
    
    echo "------------------------------------------"
    echo "💡 พิมพ์: 1-5 หรือ 1 3 5 หรือ all"
    echo "------------------------------------------"

    printf "🎯 เลือกรายการ: "
    read INPUT_CHOICE
    echo ""

    local SELECTED_INDICES=()

    if [[ "$INPUT_CHOICE" == "all" || "$INPUT_CHOICE" == "ALL" ]]; then
        for i in "${!APPS[@]}"; do
            SELECTED_INDICES+=($i)
        done
    else
        for ITEM in $INPUT_CHOICE; do
            if [[ "$ITEM" =~ ^([0-9]+)-([0-9]+)$ ]]; then
                START=${BASH_REMATCH[1]}
                END=${BASH_REMATCH[2]}
                for ((i=START; i<=END; i++)); do
                    SELECTED_INDICES+=($((i-1)))
                done
            elif [[ "$ITEM" =~ ^[0-9]+$ ]]; then
                SELECTED_INDICES+=($((ITEM-1)))
            fi
        done
    fi

    clear
    echo "╔════════════════════════════════════════╗"
    echo "║         🚀 กำลังดำเนินการติดตั้ง          ║"
    echo "╚════════════════════════════════════════╝"

    for INDEX in "${SELECTED_INDICES[@]}"; do
        if [ $INDEX -ge 0 ] && [ $INDEX -lt $TOTAL ]; then
            install_apk "$CATEGORY_NAME $((INDEX+1))" "${APPS[$INDEX]}"
        fi
    done
}

DELTA_APPS=(
  "https://raw.githubusercontent.com/suphawatinf/INFINITESHOP/refs/heads/main/delta1.apk"
  "https://raw.githubusercontent.com/suphawatinf/INFINITESHOP/refs/heads/main/delta2.apk"
)

ARCEUS_APPS=(
  "https://raw.githubusercontent.com/suphawatinf/INFINITESHOP/refs/heads/main/ArceusX.lite.by.Suphawat.1_2.737.1584.apk"
  "https://raw.githubusercontent.com/suphawatinf/INFINITESHOP/refs/heads/main/ArceusX.lite.by.Suphawat.2_2.737.1584.apk"
  "https://raw.githubusercontent.com/suphawatinf/INFINITESHOP/refs/heads/main/ArceusX.lite.by.Suphawat.3_2.737.1584.apk"
  "https://raw.githubusercontent.com/suphawatinf/INFINITESHOP/refs/heads/main/ArceusX.lite.by.Suphawat.4_2.737.1584.apk"
  "https://raw.githubusercontent.com/suphawatinf/INFINITESHOP/refs/heads/main/ArceusX.lite.by.Suphawat.5_2.737.1584.apk"
)

check_password

clear
echo "╔════════════════════════════════════════╗"
echo "║         INFINITE SHOP INSTALLER        ║"
echo "╚════════════════════════════════════════╝"
echo "[1] Delta Clones (${#DELTA_APPS[@]} Apps)"
echo "[2] ArceusX lite (${#ARCEUS_APPS[@]} Apps)"
echo "------------------------------------------"
printf "🎯 เลือกหมวดหมู่ (1-2): "
read MAIN_CHOICE
echo ""

case $MAIN_CHOICE in
    1)
        process_selection "Delta" "${DELTA_APPS[@]}"
        ;;
    2)
        process_selection "ArceusX lite" "${ARCEUS_APPS[@]}"
        ;;
    *)
        echo "[!] เลือกเมนูไม่ถูกต้อง"
        ;;
esac

echo ""
echo "------------------------------------------"
echo "          ✨ ทำงานเสร็จสิ้นเรียบร้อย! ✨       "
echo "------------------------------------------"
